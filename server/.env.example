# Copy to .env (never commit it) or set these in your host's dashboard.
PORT=3000
BASE_URL=http://localhost:3000
DATABASE_URL=postgres://user:password@host:5432/bpo_readiness
# Random string, at least 32 characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
PRICE_PESOS=799
HOLD_MINUTES=60

# Payments: "mock" (test gateway built in) or "paymongo"
PAYMENTS_PROVIDER=mock
# From PayMongo dashboard > Developers. Use sk_test_... until launch.
PAYMONGO_SECRET_KEY=
# Webhook signing secret (PayMongo gives it when you create the webhook). For mock, any random string.
PAYMENTS_WEBHOOK_SECRET=
PAYMENT_METHODS=gcash,paymaya,card

# Email and SMS: "log" writes to the outbox table only.
EMAIL_DRIVER=log
RESEND_API_KEY=
EMAIL_FROM=BPO Readiness <classes@yourdomain.ph>
SMS_DRIVER=log
SEMAPHORE_API_KEY=
SMS_SENDER=BPOREADY
